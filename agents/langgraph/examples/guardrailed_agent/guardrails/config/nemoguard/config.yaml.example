# NeMo Guardrails configuration template — nemoguard (layered NemoGuard models) profile.
# Model endpoints below default to Ollama on localhost; override per-role via
# .env for dedicated safety classifiers (see README's "Nemoguard profile" section).
# `make guardrails-server-nemoguard` generates config.yaml from this template,
# injecting LLM_BASE_URL, MODEL_ID, and API_KEY from .env.
models:
  - type: main
    engine: openai
    model: llama3.1:8b
    parameters:
      base_url: http://localhost:11434/v1
      api_key: not-needed

  - type: content_safety
    engine: openai
    model: llama3.1:8b
    parameters:
      base_url: http://localhost:11434/v1
      api_key: not-needed

  - type: topic_control
    engine: openai
    model: llama3.1:8b
    parameters:
      base_url: http://localhost:11434/v1
      api_key: not-needed

passthrough: true

rails:
  config:
    regex_detection:
      input:
        patterns:
          - "\\b(hack|exploit|bypass|inject)\\s+(the|this|my)\\s+(system|filter|guardrail)"
          - "ignore\\s+(all\\s+)?(previous|above|your)\\s+(instructions|rules|prompts)"
          - "\\bDAN\\b.*\\bjailbreak\\b"
        case_insensitive: true
  input:
    flows:
      - regex check input
      - content safety check input $model=content_safety
      - topic safety check input $model=topic_control
  output:
    flows:
      - content safety check output $model=content_safety
    streaming:
      enabled: True
