# Cluster values for the nemoguard guardrails profile (RHOAI / ci-testing).
# Copy to cluster.env and set NVIDIA_API_KEY before `make deploy-guardrails`.
#
#   cp deploy/overlays/ci-testing/cluster.env.example \\
#      deploy/overlays/ci-testing/cluster.env
#
# Inject secrets only (without re-applying manifests):
#   make deploy-guardrails-secrets

# Main LLM — in-cluster vLLM (llama-serving namespace)
MODEL_ID=qwen2-5-7b-instruct
LLM_BASE_URL=http://vllm-svc.llama-serving.svc.cluster.local:8000/v1
API_KEY=not-needed

# Nemoguard profile — NVIDIA-hosted NIM classifiers
CONTENT_SAFETY_MODEL_ID=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
CONTENT_SAFETY_MODEL_ENGINE=nim
TOPIC_CONTROL_MODEL_ID=nvidia/nemotron-3.5-content-safety
TOPIC_CONTROL_MODEL_ENGINE=nim

# Required for content_safety + topic_control NIM engines (never commit real values)
NVIDIA_API_KEY=replace-me

# OpenTelemetry tracing (optional) — per RHOAI 3.4+ official docs
# Requires: Tempo Operator installed + TempoStack CR deployed in this namespace.
# The distributor endpoint follows: http://tempo-<stack>-distributor.<ns>.svc.cluster.local:4317
# Tracing captures per-rail span data: request flow, LLM latency, rail execution times.
# Set GUARDRAILS_TRACING_ENABLED=false to disable.
GUARDRAILS_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo-sample-distributor.ci-testing.svc.cluster.local:4317
OTEL_SERVICE_NAME=nemo-guardrails
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRICS_EXPORTER=none
