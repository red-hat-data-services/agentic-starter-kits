# Cluster values for the nemoguard guardrails profile (RHOAI).
# Copy to cluster.env and set NVIDIA_API_KEY before `make deploy-guardrails`.
# The overlay directory is named ci-testing (QG4); it is not the deploy target.
#
#   cp deploy/overlays/ci-testing/cluster.env.example \\
#      deploy/overlays/ci-testing/cluster.env
#
# Inject secrets only (without re-applying manifests):
#   make deploy-guardrails-secrets
#
# Deploys into the current oc project (same as Helm make deploy). Override with:
#   make deploy-guardrails GUARDRAILS_NAMESPACE=<ns>

# Main LLM — in-cluster vLLM (llama-serving namespace)
MODEL_ID=qwen2-5-7b-instruct
LLM_BASE_URL=http://vllm-svc.llama-serving.svc.cluster.local:8000/v1
API_KEY=not-needed

# Nemoguard profile — NVIDIA-hosted NIM classifiers
CONTENT_SAFETY_MODEL_ID=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
CONTENT_SAFETY_MODEL_ENGINE=nim
TOPIC_CONTROL_MODEL_ID=nvidia/nemotron-3.5-content-safety
TOPIC_CONTROL_MODEL_ENGINE=nim

# Required for content_safety + topic_control NIM engines (never commit real values)
NVIDIA_API_KEY=replace-me

# OpenTelemetry tracing (optional, off by default)
# Requires the Tempo Operator plus a Tempo instance in GUARDRAILS_NAMESPACE.
# Full setup (demo TempoMonolithic, durable TempoStack + MinIO, metrics) is in
# deploy/tracing/README.md.
# Uncomment this whole block and set OTEL_EXPORTER_OTLP_ENDPOINT for your backend.
# Protocol/service-name/metrics default to grpc / nemo-guardrails / none if omitted.
#
# GUARDRAILS_TRACING_ENABLED=true
# OTEL_SERVICE_NAME=nemo-guardrails
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_METRICS_EXPORTER=none
#
# TempoMonolithic (demo):
#   oc apply -n <ns> -f deploy/tracing/tempo-monolithic-demo.yaml
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo-guardrails-tracing.<ns>.svc.cluster.local:4317
#
# TempoStack (durable, object storage — distributor, not the monolithic service):
#   oc apply -n <ns> -f deploy/tracing/minio-demo.yaml   # or bring your own bucket
#   oc apply -n <ns> -f deploy/tracing/tempo-stack-durable.yaml
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo-guardrails-tracing-distributor.<ns>.svc.cluster.local:4317
