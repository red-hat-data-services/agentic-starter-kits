# Required — agent connects to NeMo Guardrails proxy, not directly to the LLM
API_KEY=not-needed-for-local-development
BASE_URL=http://localhost:8090/v1
MODEL_ID=llama3.1:8b

# NeMo Guardrails — the proxy server that sits between the agent and the LLM
# Start with: make guardrails-server-local (self-check, Ollama) or
#             make guardrails-server-nemoguard (layered NemoGuard models)
# Both generate config.yaml from these values; see guardrails/config/{local,nemoguard}/.
# GUARDRAILS_PORT=8090
# LLM_BASE_URL=http://localhost:11434/v1

# Optional — use a different model/endpoint/key/engine for one or more
# guardrails layers. CONTENT_SAFETY_*/TOPIC_CONTROL_* only apply to the
# nemoguard profile (local has just a single "main" role). Any override left
# unset falls back to MODEL_ID / LLM_BASE_URL / API_KEY above (engine falls
# back to config.yaml.example's "openai"), so a single shared model needs no
# changes. Set a role's _MODEL_ENGINE to "nim" to use NVIDIA's NIM/ChatNVIDIA
# integration instead of the generic OpenAI-compatible client — needed for
# NVIDIA's purpose-built NemoGuard NIM models, e.g.
#   CONTENT_SAFETY_MODEL_ID=nvidia/llama-3.1-nemoguard-8b-content-safety
#   CONTENT_SAFETY_MODEL_ENGINE=nim
#
# Caveat: MAIN_MODEL_ID has NO effect once real traffic flows through the
# proxy — NeMo Guardrails' own server always overrides the "main" model's id
# from the client's OpenAI `model` field, which this agent always sets to
# MODEL_ID. MAIN_LLM_BASE_URL/MAIN_API_KEY do still take effect. See
# guardrails/generate_config.py's docstring for the full explanation.
# MAIN_MODEL_ID=
# MAIN_LLM_BASE_URL=
# MAIN_API_KEY=
# MAIN_MODEL_ENGINE=
# CONTENT_SAFETY_MODEL_ID=
# CONTENT_SAFETY_LLM_BASE_URL=
# CONTENT_SAFETY_API_KEY=
# CONTENT_SAFETY_MODEL_ENGINE=
# TOPIC_CONTROL_MODEL_ID=
# TOPIC_CONTROL_LLM_BASE_URL=
# TOPIC_CONTROL_API_KEY=
# TOPIC_CONTROL_MODEL_ENGINE=

# Optional — nemoguard profile only: topic_control "custom policy" mode, for models that classify
# against free-text policy (e.g. nvidia/nemotron-3.5-content-safety) instead
# of NeMo Guardrails' built-in on-topic/off-topic prompt. Auto-enabled when
# TOPIC_CONTROL_MODEL_ID matches a known custom-policy model (see
# generate_config.py); set this to force it on/override the default banking
# policy text for any other model.
# Keep this value shell-quoted because the Makefile sources `.env`:
# TOPIC_CONTROL_CUSTOM_POLICY='Banking only; reject non-banking requests.'
# Deployment
#CONTAINER_IMAGE=

# Auth (local default off; comma-separate multiple allowlist entries)
# AUTH_ENABLED=false
# AUTH_AUDIENCE=langgraph-guardrailed-agent
# AUTH_ALLOWED_SERVICEACCOUNTS=ci-testing:langgraph-guardrailed-agent-caller

# Optional — agent-level tracing (MLflow)
# The repo-standard tracing shared by every langgraph agent. Opt-in: if
# MLFLOW_TRACKING_URI is not set, the agent runs without MLflow. MLflow sees
# NeMo Guardrails as a regular ChatOpenAI endpoint, so it captures the overall
# request but NOT guardrails internals (which rail fired, classification
# results) — for that, use the OpenTelemetry path below.
#
# --- Local MLflow server (no auth, no TLS) ---
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=langgraph-guardrailed-agent

# Optional — rail-level tracing (NeMo Guardrails OpenTelemetry)
# Opt-in: off by default, zero overhead when unset. When enabled, NeMo
# Guardrails emits per-rail span data (request flow, LLM latency, rail
# decisions) — exactly what MLflow above cannot see. See README's "Tracing"
# section.
#
# --- Local: OTel Collector + Jaeger + Prometheus ---
# Start the stack first: `make guardrails-tracing-up` (needs podman-compose or
# docker compose), then set these and restart the guardrails server:
# GUARDRAILS_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=nemo-guardrails
#
# --- RHOAI cluster ---
# On RHOAI the guardrails proxy exports to a Tempo backend over gRPC. Those
# vars live in deploy/overlays/ci-testing/cluster.env.example, not here.

# Optional — guardrails integration tests (make test-guardrails-integration)
# Tests call the NeMo Guardrails proxy directly, not the agent on port 8000.
# GUARDRAILS_BASE_URL=http://localhost:8090
# GUARDRAILS_PROFILE=local
# GUARDRAILS_MODEL_ID=llama3.1:8b

# Optional — cluster guardrails behavior tests (tests/integration/test_guardrails_cluster.py)
# Set when an in-cluster guardrails proxy is deployed; requires make test-integration prerequisites.
# GUARDRAILS_INTEGRATION_URL=https://your-guardrails-proxy.example.com
