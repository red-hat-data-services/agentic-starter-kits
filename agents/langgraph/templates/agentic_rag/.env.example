# Required — LLM (MaaS)
MAAS_API_KEY=
MAAS_BASE_URL=
CHAT_BASE_URL=
# Optional override. Leave empty to use MAAS_BASE_URL.
MODEL_ID=
TEMPERATURE=0.0
MAX_COMPLETION_TOKENS=1024

# Generated RAG prompt configuration (multiline values are base64 encoded)
SYSTEM_MESSAGE_B64=
USER_MESSAGE_B64=
CONTEXT_TEMPLATE_B64=
LANGUAGE_CODE=
LANGUAGE_NAME=auto

# Required — MaaS embeddings and retrieval
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=768
RETRIEVAL_METHOD=simple
NUMBER_OF_CHUNKS=5
SEARCH_MODE=vector
RANKER_STRATEGY=
RANKER_ALPHA=
PROVIDER_TYPE=milvus

# Optional — Document Loading Configuration
DOCUMENTS_DIR=./data
CHUNK_SIZE=512

# Deployment
# After `make build-openshell`, set to:
#   image-registry.openshift-image-registry.svc:5000/<namespace>/openshell-agentic-rag:latest
CONTAINER_IMAGE=

# Milvus Configuration
# For OpenShell sandbox: use the in-cluster service (not a LoadBalancer)
MILVUS_URI=https://milvus-service.milvus.svc.cluster.local:19530
MILVUS_TOKEN=
# Leave empty and run `make load-docs-sandbox`, or set to an existing collection
MILVUS_COLLECTION_NAME=

# PEM certificate required for TLS to Milvus. It is loaded automatically from
# MILVUS_SERVER_CERT in the vector DB secret; do not set a file path here.
MILVUS_SERVER_CERT=
MILVUS_SERVER_NAME=milvus-service.milvus.svc.cluster.local
VECTOR_DB_SECRET_NAME=

# Auth (local default off; comma-separate multiple allowlist entries)
# AUTH_ENABLED=false
# AUTH_AUDIENCE=langgraph-agentic-rag
# AUTH_ALLOWED_SERVICEACCOUNTS=ci-testing:langgraph-agentic-rag-caller

# RAG-specific Configuration
VECTOR_STORE_ID=
VECTOR_STORE_PROVIDER=milvus
VECTOR_STORE_PATH=./data/milvus_lite.db
DOCS_TO_LOAD=./data/sample_knowledge.txt
# Server Configuration
PORT=8000

# Optional — MLflow Tracing
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=
# MLFLOW_HEALTH_CHECK_TIMEOUT=5
# MLFLOW_HTTP_REQUEST_TIMEOUT=2
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
# MLFLOW_TRACKING_TOKEN=
# MLFLOW_TRACKING_INSECURE_TLS=
# MLFLOW_WORKSPACE=default
# MLFLOW_TRACKING_AUTH= # Use Kubernetes service account for authentication (if running inside the cluster)

# Optional — Evaluation (only needed for `make eval`)
# The judge model scores agent responses. Can be the same as the agent's model or a different one.
# EVAL_JUDGE_MODEL=openai:/gpt-4o-mini
# EVAL_JUDGE_API_KEY=<your-api-key>
# EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
# EVAL_PII_MODEL=openai:/gpt-4.1-mini
# EVAL_ENABLE_PII=false
# EVAL_REQUEST_TIMEOUT=60
# EVAL_TRACE_TIMEOUT=60
# EVAL_POLL_INTERVAL=4
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# AGENT_URL=http://localhost:8000

# Optional — openshell sandbox
# OPENSHELL_SANDBOX_NAME=rag-sandbox
