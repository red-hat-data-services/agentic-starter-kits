# Required — LLM Configuration
API_KEY=
BASE_URL=
MODEL_ID=

# Deployment — Agent
CONTAINER_IMAGE=

# MCP Server URL (defaults: localhost:8080 for `make run-app`, in-cluster DNS for `make deploy`)
# MCP_SERVER_URL=http://127.0.0.1:8080/sse
# MCP Server — DNS rebinding protection (enabled by default in MCP SDK ≥1.x)
# DISABLE_DNS_REBINDING_PROTECTION=true

# MCP AutoML Server — model endpoint called by invoke_churn (`make run-mcp` / `make deploy-mcp`).
# Without DEPLOYMENT_URL the tool returns the validated input. See mcp_automl_template/AUTOML_DEPLOYMENT.md.
# In-cluster: <internal inference endpoint>/v1/models/<deployment-name>:predict; local: use the external route.
# DEPLOYMENT_URL=
# Optional — only when the deployment has token authentication enabled
# DEPLOYMENT_TOKEN=
# Optional — CA bundle for TLS verification (e.g. internal https endpoints signed by the OpenShift service CA)
# DEPLOYMENT_CA_BUNDLE=/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt

# Streaming — auto-detected: enabled when MLFLOW_TRACKING_URI is not set, disabled when it is.
# Set explicitly to override (see README for details).
# MODEL_CLIENT_STREAM=true

# Optional — MLflow Tracing
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=
# MLFLOW_HEALTH_CHECK_TIMEOUT=5
# MLFLOW_HTTP_REQUEST_TIMEOUT=2
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
# MLFLOW_TRACKING_TOKEN=
# MLFLOW_TRACKING_INSECURE_TLS=
# MLFLOW_WORKSPACE=default
# MLFLOW_TRACKING_AUTH= # Use Kubernetes service account for authentication (if running inside the cluster)
